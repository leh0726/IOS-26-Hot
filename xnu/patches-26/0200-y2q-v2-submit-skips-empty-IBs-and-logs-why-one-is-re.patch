From b7cf9aa79fdbac1f8e6b15e0ed31465779221c7e Mon Sep 17 00:00:00 2001
From: y2q <y2q@local>
Date: Sun, 15 Nov 2026 11:54:03 +0900
Subject: [PATCH] y2q: v2 submit skips empty IBs and logs why one is refused

---
 iokit/Kernel/arm/SweetAccelerator.cpp | 35 +++++++++++++++++++++++----
 1 file changed, 30 insertions(+), 5 deletions(-)

diff --git a/iokit/Kernel/arm/SweetAccelerator.cpp b/iokit/Kernel/arm/SweetAccelerator.cpp
index 62a9caf..54f5971 100644
--- a/iokit/Kernel/arm/SweetAccelerator.cpp
+++ b/iokit/Kernel/arm/SweetAccelerator.cpp
@@ -1178,24 +1178,49 @@ SweetAcceleratorUserClient::v2Method(uint32_t method, const void *in, uint32_t i
 		V2_OUT(NativeAdrenoAbiSubmitReply);
 		(void)sweet_v2_reap_retired();
 		if (rq->buffer_count == 0 || rq->buffer_count > NativeAdrenoAbiMaxBuffers || rq->reserved) {
+			static uint32_t said_hdr;
+			if (said_hdr++ < 8) {
+				IOLog("SWEET MTL: v2 %s: submit refused: %u buffers, reserved %#x\n", fName, rq->buffer_count,
+				    (unsigned)rq->reserved);
+			}
 			return kIOReturnBadArgument;
 		}
 		uint64_t iova[NativeAdrenoAbiMaxBuffers];
 		uint32_t dw[NativeAdrenoAbiMaxBuffers];
+		uint32_t nib = 0;
 		for (uint32_t i = 0; i < rq->buffer_count; i++) {
 			const NativeAdrenoAbiSubmitBuffer *b = &rq->buffers[i];
-			if ((b->bytes & 3) || b->bytes == 0 || b->bytes / 4 > 0xfffff || b->iova < fWinBase ||
-			    b->iova + b->bytes > fWinBase + fWinSize) {
+			/*
+			 * y2q (0200): an empty IB is skipped, not refused, and a refusal says why. Turnip makes a refused
+			 * submit a lost device (backboardd drew nothing again: "submit failed: 0xe00002c2").
+			 */
+			if (b->bytes == 0) {
+				continue;
+			}
+			const char *bad = (b->bytes & 3) ? "size not a multiple of 4" : b->bytes / 4 > 0xfffff ? "more than 1M dwords" :
+			    b->iova < fWinBase || b->iova + b->bytes > fWinBase + fWinSize ? "outside the client's window" : NULL;
+			if (bad != NULL) {
+				static uint32_t said;
+				if (said++ < 16) {
+					IOLog("SWEET MTL: v2 %s: submit refused: IB %u of %u at %llx, %llu bytes: %s (window %llx+%llx)\n",
+					    fName, i, rq->buffer_count, b->iova, b->bytes, bad, fWinBase, fWinSize);
+				}
 				return kIOReturnBadArgument;
 			}
-			iova[i] = b->iova;
-			dw[i] = (uint32_t)(b->bytes / 4);
+			iova[nib] = b->iova;
+			dw[nib] = (uint32_t)(b->bytes / 4);
+			nib++;
 		}
 		if (rq->wait_fence != 0 && sweet_gpu_wait_fence_ns((uint32_t)rq->wait_fence, rq->wait_timeout_ns)) {
 			return kIOReturnTimeout;
 		}
 		bool busy = false;
-		uint32_t fence = sweet_gpu_submit_v2(iova, dw, rq->buffer_count, &busy);
+		if (nib == 0) {
+			/* nothing to run: the client's last fence stands for it */
+			rp->fence = sweet_gpu_last_fence();
+			return kIOReturnSuccess;
+		}
+		uint32_t fence = sweet_gpu_submit_v2(iova, dw, nib, &busy);
 		if (fence == 0) {
 			return busy ? kIOReturnBusy : kIOReturnNotReady;
 		}
-- 
