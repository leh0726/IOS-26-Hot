From 8f6ffdde127ea7cfcf833ec7463a674b2367edaf Mon Sep 17 00:00:00 2001
From: y2q <y2q@local>
Date: Sat, 14 Nov 2026 20:03:06 +0900
Subject: [PATCH] y2q: data protection class D on volumes without it
 (PosterBoard data store)

---
 bsd/kern/kern_descrip.c |  8 +++++++-
 bsd/vfs/vfs_attrlist.c  | 14 ++++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/bsd/kern/kern_descrip.c b/bsd/kern/kern_descrip.c
index fac307f..ae4e7d2 100644
--- a/bsd/kern/kern_descrip.c
+++ b/bsd/kern/kern_descrip.c
@@ -4488,6 +4488,8 @@ dropboth:
 		if (!error) {
 			if (VATTR_IS_SUPPORTED(&va, va_dataprotect_class)) {
 				*retval = va.va_dataprotect_class;
+			} else if (vp->v_mount != NULL && !(vp->v_mount->mnt_flag & MNT_CPROTECT)) {
+				*retval = 4;    /* y2q (0179): class D (none) on a volume without data protection */
 			} else {
 				error = ENOTSUP;
 			}
@@ -4537,7 +4539,11 @@ dropboth:
 		VATTR_INIT(&va);
 		VATTR_SET(&va, va_dataprotect_class, tmp);
 
-		error = VNOP_SETATTR(vp, &va, ctx);
+		if (vp->v_mount != NULL && !(vp->v_mount->mnt_flag & MNT_CPROTECT)) {
+			error = 0;      /* y2q (0179): nothing to protect on this volume: accepted, not stored */
+		} else {
+			error = VNOP_SETATTR(vp, &va, ctx);
+		}
 
 		vnode_put(vp);
 		break;
diff --git a/bsd/vfs/vfs_attrlist.c b/bsd/vfs/vfs_attrlist.c
index f83e29b..a70c526 100644
--- a/bsd/vfs/vfs_attrlist.c
+++ b/bsd/vfs/vfs_attrlist.c
@@ -2142,6 +2142,14 @@ attr_pack_common(vfs_context_t ctx, mount_t mp, vnode_t vp, struct attrlist *alp
 		if (VATTR_IS_SUPPORTED(vap, va_dataprotect_class)) {
 			ATTR_PACK4((*abp), vap->va_dataprotect_class);
 			abp->actual.commonattr |= ATTR_CMN_DATA_PROTECT_FLAGS;
+		} else if (vp != NULL && vp->v_mount != NULL && !(vp->v_mount->mnt_flag & MNT_CPROTECT)) {
+			/*
+			 * y2q (0179): the HFS+ root has no data protection; say class D (NSFileProtectionNone), which is
+			 * what such a file is. PosterBoard requires NSURLFileProtectionKey == None on its data store
+			 * (PFPosterPathURLResourceValues) and refused every store without it: no wallpapers.
+			 */
+			ATTR_PACK4((*abp), 4);
+			abp->actual.commonattr |= ATTR_CMN_DATA_PROTECT_FLAGS;
 		} else if (!return_valid || pack_invalid) {
 			ATTR_PACK4((*abp), 0);
 		}
@@ -4752,12 +4760,18 @@ setattrlist_internal(vnode_t vp, struct setattrlist_args *uap, proc_t p, vfs_con
 	/* Support setattrlist of data protection class */
 	if (al.commonattr & ATTR_CMN_DATA_PROTECT_FLAGS) {
 		ATTR_UNPACK(va.va_dataprotect_class);
+		/* y2q (0179): no data protection on this volume: the class is dropped, not refused */
+		if (vp->v_mount != NULL && !(vp->v_mount->mnt_flag & MNT_CPROTECT)) {
+			goto y2q_skip_dataprotect;
+		}
 		VATTR_SET_ACTIVE(&va, va_dataprotect_class);
 #if CONFIG_MACF
 		if ((error = mac_vnode_check_dataprotect_set(ctx, vp, &va.va_dataprotect_class))) {
 			goto out;
 		}
 #endif
+y2q_skip_dataprotect:
+		;
 	}
 
 	/* volume */
-- 
2.53.0

