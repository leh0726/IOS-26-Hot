From 44f6087aea22827213ef4961689cab9427511127 Mon Sep 17 00:00:00 2001
From: y2q <y2q@local>
Date: Sun, 15 Nov 2026 00:05:56 +0900
Subject: [PATCH] y2q: sweetsamplesecs (sampler interval)

---
 bsd/dev/sweet_sample.c | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..2013dff 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -70,11 +70,17 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
-	for (int i = 0; i < 40; i++) {
+	/* y2q (0184): boot-arg sweetsamplesecs=N samples every N s (default 120), 400 times, from 60 s on */
+	int secs = 120;
+	PE_parse_boot_argn("sweetsamplesecs", &secs, sizeof(secs));
+	if (secs < 2) {
+		secs = 2;
+	}
+	(void)tsleep(&chan, PZERO, "sweetsmp", (secs < 120 ? 60 : 90) * hz);
+	for (int i = 0; i < (secs < 120 ? 400 : 40); i++) {
 		printf("SMP --- sample %d\n", i);
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+		(void)tsleep(&chan, PZERO, "sweetsmp", secs * hz);
 	}
 }
 
