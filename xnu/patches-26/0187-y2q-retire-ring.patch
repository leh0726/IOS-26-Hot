From 96ae75b219540ace4c380a786905aa173aaa7ddd Mon Sep 17 00:00:00 2001
From: y2q <y2q@local>
Date: Sun, 15 Nov 2026 01:09:06 +0900
Subject: [PATCH] y2q: BO retire ring 4096, and a forced unmap waits for the
 last fence

---
 iokit/Kernel/arm/SweetAccelerator.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/iokit/Kernel/arm/SweetAccelerator.cpp b/iokit/Kernel/arm/SweetAccelerator.cpp
index 364b39c..0c65afa 100644
--- a/iokit/Kernel/arm/SweetAccelerator.cpp
+++ b/iokit/Kernel/arm/SweetAccelerator.cpp
@@ -675,7 +675,7 @@ sweet_pool_release(IOMemoryDescriptor *md, uint64_t pa)
  * the GPU ring, keeps its SMMU PTEs and wired/pool pages alive until sweet_gpu_last_fence() completes,
  * and reaps completed entries in batches (one TLB flush per batch).
  */
-#define SWEET_V2_RETIRE_CAP     256
+#define SWEET_V2_RETIRE_CAP     4096    /* y2q (0187): live blur frees hundreds of textures a second; 256 filled up */
 #define SWEET_V2_REAP_BATCH     16
 
 struct sweet_v2_retired {
@@ -890,6 +890,15 @@ sweet_v2_retire_bo(const SweetV2BO *dead)
 		IOLockUnlock(sweet_retire_lock);
 		if (!sweet_v2_wait_oldest_retired()) {
 			if (dead->iova != 0) {
+				/*
+				 * y2q (0187): the ring is full and nothing could be reaped: this BO is unmapped right here, so wait
+				 * for the work submitted up to now first. Unmapped at once, a texture the GPU was still writing
+				 * faulted (SMMU write fault, GPU reset: the screen flickered and went black, SpringBoard died).
+				 */
+				uint32_t f = sweet_gpu_last_fence();
+				if (f != 0) {
+					(void)sweet_gpu_wait_fence_ns(f, 2000000000ULL);
+				}
 				sweet_gpu_unmap_at(dead->iova, dead->bytes);
 			}
 			struct sweet_v2_retired one = {
-- 
