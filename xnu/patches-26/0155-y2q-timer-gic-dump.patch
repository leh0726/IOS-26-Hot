@@ -228,3 +228,22 @@ pe_init_fiq()
 {
 }
 #endif
+
+#if defined(SWEET)
+/* y2q SMP bring-up (0155): this CPU's redistributor state and the distributor control */
+void y2q_gic_dump(const char *tag);
+void
+y2q_gic_dump(const char *tag)
+{
+	if (gicr_base == 0 || gicd_base == 0) {
+		return;
+	}
+	vm_offset_t gicr_pe_base = find_gicr_pe_base();
+	kprintf("Y2Q GIC %s: mpidr %llx rd +0x%lx waker %x grp %x en %x pend %x act %x cfg1 %x pri16_19 %08x gicd_ctlr %x\n",
+	    tag, (unsigned long long)(__builtin_arm_rsr64("MPIDR_EL1") & 0xffff),
+	    (unsigned long)(gicr_pe_base - gicr_base),
+	    gicr_read32(GICR_WAKER), gicr_read32(GICR_IGROUPR0), gicr_read32(GICR_ISENABLER0),
+	    gicr_read32(0x10200), gicr_read32(0x10300), gicr_read32(0x10C04),
+	    gicr_read32(GICR_IPRIORITYR0 + 16), gicd_read32(GICD_CTLR));
+}
+#endif /* SWEET */
