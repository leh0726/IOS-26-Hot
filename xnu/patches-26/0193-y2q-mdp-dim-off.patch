From 1b3f289d1413f5dc42a85da2f216853dbc4c8256 Mon Sep 17 00:00:00 2001
From: y2q <y2q@local>
Date: Sun, 15 Nov 2026 10:11:28 +0900
Subject: [PATCH] y2q: MDP dim off by default (flush not consumed on the y2q)

---
 bsd/dev/sweet_gpu.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 48b8543..747809e 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -764,7 +764,7 @@ sweet_gpu_present(int s, uintptr_t kva, uint32_t offset, uint32_t w, uint32_t h,
 		static int mdpdim = -1;
 		static uint32_t mdp_dim_now = 0xffffffffu;
 		if (mdpdim < 0) {
-			int v = 1;
+			int v = 0;	/* 0193: off by default: the y2q's CTL never consumes the flush (stays pending) */
 			PE_parse_boot_argn("sweetmdpdim", &v, sizeof(v));
 			mdpdim = v;
 		}
-- 
2.53.0

