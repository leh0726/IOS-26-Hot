From 14cab2188e69a06206b1b0fdf41b8639fb4ec4e6 Mon Sep 17 00:00:00 2001
From: y2q <y2q@local>
Date: Sun, 15 Nov 2026 10:17:32 +0900
Subject: [PATCH] y2q: vsync timer kernel-high without leeway, ideal timestamps
 to CA, lateness stats

---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 31 ++++++++++++++++++++++-----
 1 file changed, 26 insertions(+), 5 deletions(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index f7e1446..9068994 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -116,6 +116,8 @@ class AppleCLCD : public IOMobileFramebuffer {
 	IOTimerEventSource *fVsync;
 	uint64_t            fVsyncCount;
 	uint64_t            fNextVsync;     /* absolute deadline of the next tick */
+	uint64_t            fVsyncLateMax, fVsyncLateSum;     /* y2q 0194 */
+	uint32_t            fVsyncSkips;
 	uint64_t            fVsyncAbs;      /* tick period in absolute time units */
 	uint64_t            fStatSwaps, fStatPresents, fStatPresentAbs;
 
@@ -277,7 +279,7 @@ AppleCLCD::start(IOService *provider)
 		OSSafeReleaseNULL(fWorkLoop);
 		return false;
 	}
-	fVsync = IOTimerEventSource::timerEventSource(this, &AppleCLCD::vsyncFired);
+	fVsync = IOTimerEventSource::timerEventSource(kIOTimerEventSourceOptionsPriorityKernelHigh, this, &AppleCLCD::vsyncFired);  /* y2q 0194 */
 	if (fVsync == NULL || fWorkLoop->addEventSource(fVsync) != kIOReturnSuccess) {
 		IOLog("SWEET FB: no vsync timer\n");
 		return false;
@@ -314,11 +316,26 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		nanoseconds_to_absolutetime(SWEET_FB_VSYNC_US * 1000ULL, &fb->fVsyncAbs);
 		fb->fNextVsync = now;
 	}
+	/*
+	 * y2q (0194): this tick's ideal time goes to CA (a2), not when the timer happened to run: CA's next
+	 * deadline is a2 + a3, and every late tick (timer coalescing, workloop latency) moved it on and cost
+	 * frames. The timer is kernel-high priority with no leeway, so it is not coalesced either.
+	 */
+	uint64_t ideal = fb->fNextVsync;
+	if (now > ideal) {
+		uint64_t late = now - ideal;
+		if (late > fb->fVsyncLateMax) {
+			fb->fVsyncLateMax = late;
+		}
+		fb->fVsyncLateSum += late;
+	}
 	fb->fNextVsync += fb->fVsyncAbs;
 	if (fb->fNextVsync <= now) {
 		fb->fNextVsync = now + fb->fVsyncAbs;
+		ideal = now;
+		fb->fVsyncSkips++;
 	}
-	sender->wakeAtTime(fb->fNextVsync);
+	sender->wakeAtTime(kIOTimeOptionsWithLeeway, fb->fNextVsync, 0);
 	if ((count % 300) == 0) {
 		/* Every 5 s: frames backboardd swapped, frames copied to the panel. */
 		IOLockLock(fb->fLock);
@@ -336,9 +353,13 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		fb->fLast5sFpsX10 = (uint32_t)(swaps * 2ULL);
 		IOLockUnlock(fb->fLock);
 		if (swaps || presents) {
-			IOLog("SWEET FB: 5s: %llu swaps (%llu.%llu fps), %llu panel copies, avg copy %llu us\n",
-			    swaps, swaps / 5, (swaps * 2) % 10, presents, avg_us);
+			uint64_t lmax = 0, lavg = 0;
+			absolutetime_to_nanoseconds(fb->fVsyncLateMax, &lmax);
+			absolutetime_to_nanoseconds(fb->fVsyncLateSum / 300, &lavg);
+			IOLog("SWEET FB: 5s: %llu swaps (%llu.%llu fps), %llu panel copies, avg copy %llu us; vsync late avg %llu us max %llu us, %u resyncs\n", swaps, swaps / 5, (swaps * 2) % 10, presents, avg_us, lavg / 1000, lmax / 1000, fb->fVsyncSkips);
 		}
+		fb->fVsyncLateMax = fb->fVsyncLateSum = 0;
+		fb->fVsyncSkips = 0;
 	}
 	/*
 	 * CA::WindowServer::IOMFBServer::vsync_callback(fb, a1, a2, a3, refcon): a1 only goes to kdebug, a2 is
@@ -348,7 +369,7 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 	uint64_t period = fb->fVsyncAbs;
 	uint64_t values[6] = {
 		(uint32_t)count, (uint32_t)(count >> 32),
-		(uint32_t)now, (uint32_t)(now >> 32),
+		(uint32_t)ideal, (uint32_t)(ideal >> 32),
 		(uint32_t)period, (uint32_t)(period >> 32),
 	};
 
-- 
2.53.0

