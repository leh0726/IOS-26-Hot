diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index abcc544..dbb8326 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -246,4 +246,19 @@ y2q_gic_dump(const char *tag)
 	    gicr_read32(0x10200), gicr_read32(0x10300), gicr_read32(0x10C04),
 	    gicr_read32(GICR_IPRIORITYR0 + 16), gicd_read32(GICD_CTLR));
 }
+
+/* y2q SMP bring-up (0158): enable/pending/active of redistributor frame idx (another CPU) */
+void y2q_gic_peek(unsigned int idx, uint32_t out[3]);
+void
+y2q_gic_peek(unsigned int idx, uint32_t out[3])
+{
+	out[0] = out[1] = out[2] = 0xdeadbeef;
+	if (gicr_base == 0 || (vm_offset_t)idx * GICR_PE_SIZE >= gicr_size) {
+		return;
+	}
+	vm_offset_t gicr_pe_base = gicr_base + (vm_offset_t)idx * GICR_PE_SIZE;
+	out[0] = gicr_read32(GICR_ISENABLER0);
+	out[1] = gicr_read32(0x10200);
+	out[2] = gicr_read32(0x10300);
+}
 #endif /* SWEET */
